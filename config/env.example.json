{
  "_readme": "Copy to config/env.json (gitignored) and point it at YOUR app. Without env.json the framework uses this file, which targets the public TodoMVC demo so you can try it immediately.",

  "APP_NAME": "TodoMVC demo",
  "APP_REPO": "",

  "TARGET_ENV": "demo",
  "ENVIRONMENTS": {
    "demo": "https://demo.playwright.dev/todomvc/",
    "local": "http://localhost:3000/"
  },
  "ALLOW_DESTRUCTIVE_ON": ["demo", "local"],
  "NEVER_RUN_ON": ["production"],

  "ROUTE_ALIASES": {},
  "PUBLIC_ROUTE_PATTERNS": ["^/$", "^/#/", "^/login", "^/signup", "^/help"],

  "LOGIN": {
    "path": "/login",
    "usernameSelector": "input[type=email], input[name=username], #username",
    "passwordSelector": "input[type=password]",
    "submitText": "Sign in"
  },

  "DATA_PREFIX": "AGT",
  "REDACT_EMAILS_IN_REPORTS": true
}
