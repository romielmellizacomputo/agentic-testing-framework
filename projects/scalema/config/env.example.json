{
  "_readme": "Committed config. These hosts are NOT in the default allowlist (tools/e2e/targets.mjs); enable with AGT_EXTRA_ALLOWED_HOSTS only after confirming they are test environments.",
  "APP_NAME": "Scalema (scalema.com)",
  "APP_REPO": "",
  "TARGET_ENV": "staging",
  "ENVIRONMENTS": {
    "staging": "https://staging.scalema.com/"
  },
  "ALLOW_DESTRUCTIVE_ON": [
    "staging"
  ],
  "NEVER_RUN_ON": [
    "production"
  ],
  "ROUTE_ALIASES": {},
  "PUBLIC_ROUTE_PATTERNS": [
    "^/$",
    "^/(about|business|data-retention-policy|faqs|privacy-policy|terms-and-conditions|404)"
  ],
  "LOGIN": {
    "path": "/",
    "usernameSelector": "input[type=email]",
    "passwordSelector": "input[type=password]",
    "submitText": "Sign in"
  },
  "DATA_PREFIX": "AGT",
  "REDACT_EMAILS_IN_REPORTS": true
}
