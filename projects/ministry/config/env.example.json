{
  "_readme": "Committed config. These hosts are NOT in the default allowlist (tools/e2e/targets.mjs); enable with AGT_EXTRA_ALLOWED_HOSTS only after confirming they are test environments.",
  "APP_NAME": "Ministry / CentralBPO internal admin (ministry-vuejs)",
  "APP_REPO": "",
  "TARGET_ENV": "develop",
  "ENVIRONMENTS": {
    "develop": "https://develop-centralbpo.cxrole.com/",
    "staging": "https://staging-centralbpo.cxrole.com/"
  },
  "ALLOW_DESTRUCTIVE_ON": [
    "develop",
    "staging"
  ],
  "NEVER_RUN_ON": [
    "production"
  ],
  "ROUTE_ALIASES": {},
  "PUBLIC_ROUTE_PATTERNS": [
    "^/$"
  ],
  "LOGIN": {
    "path": "/",
    "usernameSelector": "input[type=email], input[name=username], #username",
    "passwordSelector": "input[type=password]",
    "submitText": "Log in"
  },
  "DATA_PREFIX": "AGT",
  "REDACT_EMAILS_IN_REPORTS": true
}
