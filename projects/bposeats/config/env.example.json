{
  "_readme": "Committed config. These hosts are NOT in the default allowlist (tools/e2e/targets.mjs); enable with AGT_EXTRA_ALLOWED_HOSTS only after confirming they are test environments.",
  "APP_NAME": "BPOSeats (bposeats.com)",
  "APP_REPO": "",
  "TARGET_ENV": "develop",
  "ENVIRONMENTS": {
    "develop": "https://develop-bposeats.cxrole.com/",
    "staging": "https://staging-bposeats.cxrole.com/"
  },
  "ALLOW_DESTRUCTIVE_ON": [
    "develop",
    "staging"
  ],
  "NEVER_RUN_ON": [
    "production"
  ],
  "ROUTE_ALIASES": {},
  "PUBLIC_ROUTE_PATTERNS": [
    "^/$",
    "^/(offices|buildings|bpo|offshore|outsourcing|philippines-bpo|remote-teams|staffing|hiring|features|ecosystem|contact|currency|info|go|release-notes|terms-and-conditions|terms-of-service|mobile-privacy-policy|trademarks|signin|signup|password-reset|password-change|executive-verification|404)"
  ],
  "LOGIN": {
    "path": "/signin",
    "usernameSelector": "input[type=email], input[name=username], #username",
    "passwordSelector": "input[type=password]",
    "submitText": "Sign in"
  },
  "DATA_PREFIX": "AGT",
  "REDACT_EMAILS_IN_REPORTS": true
}
