{
  "_readme": "Committed config used by CI. Only the two HQZen TEST environments are listed; production is refused. A private env.json (gitignored) can override this locally.",

  "APP_NAME": "HQZen",
  "APP_REPO": "",

  "TARGET_ENV": "develop",
  "ENVIRONMENTS": {
    "develop": "https://develop-hqzen.cxrole.com/",
    "staging": "https://staging-hqzen.cxrole.com/",
    "local": "http://localhost:8080/"
  },
  "ALLOW_DESTRUCTIVE_ON": ["local", "develop", "staging"],
  "NEVER_RUN_ON": ["production"],

  "DEFAULT_COMPANY": "<test company name>",
  "DEFAULT_WORKFORCE": "<test workforce name>",

  "ROUTE_ALIASES": {
    "{ws}": "/company/:company_id/workforce/:workforce_id"
  },
  "PUBLIC_ROUTE_PATTERNS": [
    "^/$", "^/(jobs|applicants|legacy|help-center|privacy-policy|trademarks|release-notes|resumes|signin|signup|password|executive-verification|access-denied|not-found|link-expired|404|post-a-job|build-your-team|compensation|solutions-generator|scalema-external-query|unsubscribe-email|engagement|chatbot|concerns|redirect|google)",
    "^/forms/:share_code"
  ],

  "LOGIN": {
    "path": "/signin",
    "usernameSelector": "#username",
    "passwordSelector": "#password",
    "submitText": "Sign in"
  },

  "DATA_PREFIX": "AGT",
  "REDACT_EMAILS_IN_REPORTS": true
}
