# --- Private configuration (never commit) ---
# Every project keeps real URLs and accounts in these gitignored files;
# only the *.example.* files next to them are public.
projects/*/config/env.json
projects/*/config/accounts.local.json
projects/*/config/roles.md
/config/
.agt-project
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# --- Generated route/component inventories: they map your app's internals ---
projects/*/inventory/*
!projects/*/inventory/README.md

# --- Test browser profile (cookies, sessions) ---
.browser-profile/

# --- Run outputs: contain app data. Commit only to PRIVATE repos, after review. ---
runs/*
!runs/README.md
reports/*
!reports/README.md
bugs/*
!bugs/README.md
unit-drafts/*
!unit-drafts/README.md
scripted-drafts/

# --- Tooling ---
node_modules/
*.tmp
*.log
.DS_Store
Thumbs.db
